#!/bin/bash
set -euo pipefail
[[ "$(id -u)" == 1000 && "$(id -un)" == cloudplay ]] || exit 1
[[ -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]] || exit 1
umask 077
state="$HOME/.config/cloudplay"
mkdir -p "$state"
chmod 700 "$state"
exec /usr/bin/python3 /usr/local/lib/cloudplay/launcher/main.py
