#!/bin/bash
set -euo pipefail
[[ "$(id -u)" -ge 1000 && "$(id -un)" != rpi-first-boot-wizard ]] || exit 1
umask 077
state="${XDG_CONFIG_HOME:-$HOME/.config}/cloudplay"
mkdir -p "$state"
chmod 700 "$state"
choice="$(zenity --list --title='Cloudplay preview — local settings' \
    --text='Use the desktop panel for Wi-Fi, Bluetooth, audio and display settings.\nChromium is security-held; read /usr/local/share/cloudplay/SECURITY.txt.\n4K60 and HDR are goals, NOT validated capabilities.' \
    --column=Action 'Start GeForce NOW' 'Boot to desktop' 'Boot to GeForce NOW' 'Security notice' \
    --width=680 --height=300)" || exit 0
case "$choice" in
    'Start GeForce NOW') exec cloudplay-start ;;
    'Boot to desktop') touch "$state/desktop-only" ;;
    'Boot to GeForce NOW') rm -f "$state/desktop-only" ;;
    'Security notice') zenity --text-info --filename=/usr/local/share/cloudplay/SECURITY.txt --width=760 --height=500 ;;
esac
