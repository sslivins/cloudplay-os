# Cloudplay OS: approved artwork, with its baked footer removed for live status.
Window.SetBackgroundTopColor(5 / 255, 9 / 255, 16 / 255);
Window.SetBackgroundBottomColor(5 / 255, 9 / 255, 16 / 255);
source_image = Image("cloudplay-background.png");
image = source_image;
sprite = Sprite(image);
spinner = [];
scaled_spinner = [];
for (i = 0; i < 12; i++) {
    if (i < 10)
        spinner[i] = Image("spinner-0" + i + ".png");
    else
        spinner[i] = Image("spinner-" + i + ".png");
}
spinner_sprite = Sprite();
status_sprite = Sprite();
status_text = "Starting Cloudplay OS";
if (Plymouth.GetMode() == "shutdown")
    status_text = "Shutting down Cloudplay OS";
if (Plymouth.GetMode() == "reboot")
    status_text = "Restarting Cloudplay OS";
status_source = Image.Text(status_text, 0.55, 0.68, 0.76, 1, "Sans 16");
frame = 0;
screen_width = -1;
screen_height = -1;

fun refresh() {
    if (Window.GetWidth() != global.screen_width || Window.GetHeight() != global.screen_height) {
        global.screen_width = Window.GetWidth();
        global.screen_height = Window.GetHeight();
        scale = global.screen_width / source_image.GetWidth();
        if (global.screen_height / source_image.GetHeight() < scale)
            scale = global.screen_height / source_image.GetHeight();
        if (scale == 1)
            global.image = source_image;
        else
            global.image = source_image.Scale(Math.Int(source_image.GetWidth() * scale),
                Math.Int(source_image.GetHeight() * scale));
        sprite.SetImage(global.image);
        global.scale = scale;
        for (i = 0; i < 12; i++)
            global.scaled_spinner[i] = spinner[i].Scale(Math.Int(40 * scale), Math.Int(40 * scale));
        global.status_image = status_source.Scale(Math.Int(status_source.GetWidth() * scale),
            Math.Int(status_source.GetHeight() * scale));
        status_sprite.SetImage(global.status_image);
    }
    x = Window.GetX() + (Window.GetWidth() - global.image.GetWidth()) / 2;
    y = Window.GetY() + (Window.GetHeight() - global.image.GetHeight()) / 2;
    sprite.SetPosition(x, y, 0);
    global.frame++;
    spinner_sprite.SetImage(scaled_spinner[Math.Int(global.frame / 2) % 12]);
    spinner_sprite.SetPosition(x + 940 * global.scale, y + 846 * global.scale, 1);
    status_sprite.SetPosition(x + (global.image.GetWidth() - status_image.GetWidth()) / 2,
        y + 913 * global.scale - status_image.GetHeight() / 2, 1);
}
fun display_message(message) {
    global.status_source = Image.Text(message, 0.55, 0.68, 0.76, 1, "Sans 16");
    global.screen_width = -1;
}
Plymouth.SetRefreshFunction(refresh);
Plymouth.SetDisplayMessageFunction(display_message);
refresh();
