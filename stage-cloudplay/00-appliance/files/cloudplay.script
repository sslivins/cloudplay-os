# Approved Cloudplay OS artwork includes the wordmark, startup text and dots.
# Do not overlay another label or spinner, or require runtime Windows fonts.
Window.SetBackgroundTopColor(5 / 255, 9 / 255, 16 / 255);
Window.SetBackgroundBottomColor(5 / 255, 9 / 255, 16 / 255);
source_image = Image("cloudplay.png");
image = source_image;
sprite = Sprite(image);
screen_width = -1;
screen_height = -1;

fun refresh() {
    if (Window.GetWidth() != global.screen_width || Window.GetHeight() != global.screen_height) {
        global.screen_width = Window.GetWidth();
        global.screen_height = Window.GetHeight();
        scale = global.screen_width / source_image.GetWidth();
        if (global.screen_height / source_image.GetHeight() < scale)
            scale = global.screen_height / source_image.GetHeight();
        if (scale == 1)
            global.image = source_image;
        else
            global.image = source_image.Scale(Math.Int(source_image.GetWidth() * scale),
                Math.Int(source_image.GetHeight() * scale));
        sprite.SetImage(global.image);
    }
    sprite.SetPosition(Window.GetX() + (Window.GetWidth() - global.image.GetWidth()) / 2,
        Window.GetY() + (Window.GetHeight() - global.image.GetHeight()) / 2, 0);
}
Plymouth.SetRefreshFunction(refresh);
refresh();
