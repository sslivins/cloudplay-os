[Unit]
Description=Enforce Cloudplay tentative update deadline independently
Requires=cloudplay-data.service cloudplay-update-bootstrap.service
After=cloudplay-data.service cloudplay-update-bootstrap.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /usr/lib/cloudplay/image/boot-service.py deadline
TimeoutStartSec=2min
UMask=0077
